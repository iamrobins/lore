{
  "name": "@iamrobins/lore-mcp",
  "version": "0.1.0",
  "description": "Read and write .lore/ notes from any MCP-speaking AI coding agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lore-mcp": "dist/server.js"
  },
