    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
