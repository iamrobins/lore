{
  "name": "lore",
  "displayName": "Lore — sticky notes & AI context for your code",
  "description": "Notes that live beside your code instead of inside it. Stored as Markdown in git, readable by AI coding agents.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "iamrobins",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamrobins/lore.git"
  },
  "bugs": {
    "url": "https://github.com/iamrobins/lore/issues"
  },
  "homepage": "https://github.com/iamrobins/lore#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "notes",
    "annotations",
    "documentation",
    "ai",
    "context"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.lore"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lore",
          "title": "Lore",
          "icon": "media/lore.svg"
        }
      ]
    },
    "views": {
      "lore": [
        {
          "id": "lore.notes",
          "name": "Notes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lore.notes",
        "contents": "No notes yet.\n[Add a note](command:lore.new)\nNotes live in `.lore/` and travel with git."
      }
    ],
    "commands": [
      {
        "command": "lore.new",
        "title": "New Note",
        "category": "Lore",
        "icon": "$(add)"
      },
      {
        "command": "lore.reveal",
        "title": "Go to Code",
        "category": "Lore"
      },
      {
        "command": "lore.openNote",
        "title": "Open Note",
        "category": "Lore",
        "icon": "$(edit)"
      },
      {
        "command": "lore.reattach",
        "title": "Re-attach Note to Cursor",
        "category": "Lore"
      },
      {
        "command": "lore.share",
        "title": "Share with Team",
        "category": "Lore"
      },
      {
        "command": "lore.unshare",
        "title": "Make Personal",
        "category": "Lore"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lore.new",
          "when": "view == lore.notes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lore.openNote",
          "when": "view == lore.notes && viewItem =~ /^loreNote/",
          "group": "inline"
        },
        {
          "command": "lore.reattach",
          "when": "view == lore.notes && viewItem =~ /^loreNote/",
          "group": "1_modify"
        },
        {
          "command": "lore.share",
          "when": "view == lore.notes && viewItem =~ /^loreNote\\.personal/",
          "group": "2_scope"
        },
        {
          "command": "lore.unshare",
          "when": "view == lore.notes && viewItem =~ /^loreNote\\.team/",
          "group": "2_scope"
        }
      ],
      "commandPalette": [
        {
          "command": "lore.reveal",
          "when": "false"
        },
        {
          "command": "lore.openNote",
          "when": "false"
        },
        {
          "command": "lore.reattach",
          "when": "false"
        },
        {
          "command": "lore.share",
          "when": "false"
        },
        {
          "command": "lore.unshare",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lore.new",
        "key": "alt+n",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc && tsc -p mcp && tsc -p plugin",
    "test": "npm run check && node --test \"out/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "compile:mcp": "node mcp/build.mjs",
    "compile:plugin": "node plugin/build.mjs",
    "compile:all": "npm run compile && npm run compile:mcp && npm run compile:plugin"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
